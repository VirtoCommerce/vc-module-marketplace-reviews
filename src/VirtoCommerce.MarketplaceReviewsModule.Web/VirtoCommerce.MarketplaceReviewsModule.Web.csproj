<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="reviews-app\**" />
    <Content Remove="reviews-app\**" />
    <EmbeddedResource Remove="reviews-app\**" />
    <None Remove="reviews-app\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.MarketplaceVendorModule.Data" Version="3.1000.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.MarketplaceReviewsModule.Core\VirtoCommerce.MarketplaceReviewsModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketplaceReviewsModule.Data\VirtoCommerce.MarketplaceReviewsModule.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ReviewsApp Include="reviews-app\dist\**" />
    <!-- MF plugin remote produced by `yarn build:modules-bundle` lands at
         <moduleRoot>/plugins/<appId>/ — the platform's manifest endpoint
         (GET /api/apps/<appId>/manifest) discovers remoteEntry.js there. -->
    <PluginRemotes Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(ReviewsApp)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
    <Copy SourceFiles="@(ReviewsAppNew)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
    <Copy SourceFiles="@(PluginRemotes)" DestinationFiles="$(PublishDir)\..\plugins\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>
  <ItemGroup>
    <Folder Include="Scripts\blades\" />
  </ItemGroup>
</Project>
